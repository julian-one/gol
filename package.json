{
	"name": "@julianone/gol",
	"version": "0.1.0",
	"description": "Conway's Game of Life, animated in the terminal or on a canvas.",
	"type": "module",
	"bin": {
		"gol": "dist/cli.js"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"src",
		"!src/**/*.test.ts"
	],
	"engines": {
		"node": ">=26"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "rm -rf dist && tsc",
		"dev": "tsc --watch",
		"start": "tsc && node dist/cli.js",
		"test": "vitest run",
		"format": "prettier . --write",
		"lint": "eslint .",
		"prepare": "husky",
		"prepublishOnly": "npm run lint && npm test && npm run build"
	},
	"lint-staged": {
		"*.{js,ts}": [
			"prettier --write",
			"eslint"
		]
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/julian-one/gol.git"
	},
	"keywords": [
		"game-of-life",
		"conway",
		"life",
		"cellular-automaton",
		"canvas",
		"terminal",
		"cli"
	],
	"author": "julian-one",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/julian-one/gol/issues"
	},
	"homepage": "https://github.com/julian-one/gol#readme",
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^26.6.6",
		"eslint": "^10.15.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.2",
		"prettier": "3.10.1",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.73.0",
		"vitest": "^5.1.1"
	}
}
