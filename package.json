	},
	"homepage": "https://github.com/julian-one/gol#readme",
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^26.6.6",
		"eslint": "^10.15.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.2",
		"prettier": "3.10.1",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.73.0",
		"vitest": "^5.1.1"
